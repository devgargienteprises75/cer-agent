# Drive folder ID where images should be uploaded.
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Free personal Google Drive option: set all three OAuth values together.
# Leave them blank to use the service account (requires a Shared Drive).
# Generate the refresh token with the https://www.googleapis.com/auth/drive scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional service account key path, used only when OAuth values are blank.
# GOOGLE_APPLICATION_CREDENTIALS=./service-client.json
